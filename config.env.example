# Токен Telegram бота
BOT_TOKEN=your_bot_token_here

# ID получателя для отправки данных форм
RECIPIENT_ID=your_admin_chat_id

# Терминалы Т-банка
TBANK_MERCHANT_ID=your_merchant_id
TBANK_API_KEY=your_api_key
TBANK_SECRET_KEY=your_secret_key
TBANK_TERMINAL_KEY=your_terminal_key

# Дополнительные настройки
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_WEBHOOK_URL=https://your-domain.com/api/tbank-webhook
TBANK_SUCCESS_URL=https://securepay.tinkoff.ru/html/payForm/success.html
TBANK_FAIL_URL=https://securepay.tinkoff.ru/html/payForm/fail.html

# PostgreSQL настройки
DB_HOST=localhost
DB_PORT=5432
DB_NAME=easydrive
DB_USER=easydrive_user
DB_PASSWORD=your_secure_password_here

